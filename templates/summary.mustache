{{!
    @template enrol_mpcheckoutpro/summary

    Totals per payment status shown above the transaction report.

    Context variables required for this template:
    * stats - array of {label, count, amount, isapproved}

    Example context (json):
    {
        "stats": [
            {"label": "Approved", "count": 12, "amount": "ARS 180000.00", "isapproved": true},
            {"label": "Rejected", "count": 3, "amount": "ARS 45000.00", "isapproved": false}
        ]
    }
}}
{{#stats.0}}
<div class="enrol-mpcheckoutpro-summary d-flex flex-wrap gap-2 mb-3">
    {{#stats}}
        <div class="card {{#isapproved}}border-success{{/isapproved}}">
            <div class="card-body py-2 px-3">
                <div class="small text-muted">{{label}}</div>
                <div class="h5 mb-0">{{count}}</div>
                <div class="small">{{amount}}</div>
            </div>
        </div>
    {{/stats}}
</div>
{{/stats.0}}
