{{!
    @template enrol_mercadopagocpro/enrol_page

    Body of the enrolment widget shown on the course enrolment page.

    Context variables required for this template:
    * cost - formatted price including the currency symbol
    * currency - ISO-4217 currency code
    * description - optional description of what is being bought
    * installments - maximum installments offered, 0 to hide
    * testmode - true when the site is using Mercado Pago test credentials
    * haspending - true when the user already has a payment being processed
    * pendingstatus - label of that pending payment

    Example context (json):
    {
        "cost": "$ 15.000,00",
        "currency": "ARS",
        "description": "Full access for 12 months",
        "installments": 6,
        "testmode": false,
        "haspending": false,
        "pendingstatus": ""
    }
}}
<div class="enrol-mercadopagocpro">
    {{#testmode}}
        <div class="alert alert-warning" role="alert">
            {{#str}} testmodenotice, enrol_mercadopagocpro {{/str}}
        </div>
    {{/testmode}}

    {{#haspending}}
        <div class="alert alert-info" role="status">
            {{#str}} pendingpaymentnotice, enrol_mercadopagocpro, {{pendingstatus}} {{/str}}
        </div>
    {{/haspending}}

    <p class="enrol-mercadopagocpro-cost h4 mb-2">
        {{#str}} labelvalue, core, {"label": {{#quote}}{{#str}} cost, enrol_mercadopagocpro {{/str}}{{/quote}}, "value": {{#quote}}{{cost}}{{/quote}} }{{/str}}
    </p>

    {{#description}}
        <p class="enrol-mercadopagocpro-description text-muted">{{description}}</p>
    {{/description}}

    {{#installments}}
        <p class="enrol-mercadopagocpro-installments">
            {{#str}} installmentsavailable, enrol_mercadopagocpro, {{installments}} {{/str}}
        </p>
    {{/installments}}

    <p class="enrol-mercadopagocpro-notice small text-muted mb-0">
        {{#str}} redirectnotice, enrol_mercadopagocpro {{/str}}
    </p>
</div>
